@page "/"

@inject IPostRepository Repository
@inject IFileStorage Storage
@inject IUserSession Session
@inject ISubjectCatalog Subjects
@inject IContentKindResolver ContentKinds

<PageTitle>KnowledgeGram</PageTitle>

<div class="topbar">
    <h1>📚 KnowledgeGram</h1>
    <div>
        @if (!Session.IsSignedIn)
        {
            <input placeholder="Pick a username" @bind="loginName" />
            <button @onclick="Login">Log in</button>
        }
        else
        {
            <span>Hi, @Session.UserName! </span>
            <button @onclick="Logout">Log out</button>
        }
    </div>
</div>

<div class="container">

    @* ---------- NEW POST ---------- *@
    @if (Session.IsSignedIn)
    {
        <div class="card">
            <h3>Share some knowledge</h3>
            <input type="text" placeholder="Title" @bind="newTitle" />
            <textarea rows="3" placeholder="Write your notes here..." @bind="newBody"></textarea>
            <select @bind="newSubject">
                @foreach (var subject in Subjects.All)
                {
                    <option value="@subject">@subject</option>
                }
            </select>
            <div style="margin-bottom:8px">
                <InputFile @key="inputKey" OnChange="OnFileChosen" />
            </div>
            @if (message != "")
            {
                <div class="error">@message</div>
            }
            <button @onclick="Publish">Publish</button>
        </div>
    }
    else
    {
        <div class="card">Log in (top right) to share and comment.</div>
    }

    @* ---------- SEARCH / FILTER ---------- *@
    <div class="card filters">
        <input type="text" placeholder="Search..." @bind="search" style="margin:0" />
        <select @bind="filterSubject" style="margin:0">
            <option value="">All subjects</option>
            @foreach (var subject in Subjects.All)
            {
                <option value="@subject">@subject</option>
            }
        </select>
        <button @onclick="LoadFeed">Go</button>
    </div>

    @* ---------- FEED ---------- *@
    @foreach (var post in feed)
    {
        <div class="card post">
            @if (post.Author == Session.UserName)
            {
                <button class="danger" @onclick="() => DeletePost(post)">Delete</button>
            }
            <h3>@post.Title</h3>
            <div class="meta">
                <b>@post.Author</b> · @post.CreatedAt.ToString("yyyy-MM-dd HH:mm") · <span class="subject">@post.Subject</span>
            </div>
            <p>@post.Body</p>

            @if (post.Attachment is not null)
            {
                var url = Storage.GetUrl(post.Attachment.StoredName);
                var kind = ContentKinds.Resolve(post.Attachment.OriginalName);

                if (kind == ContentKind.Image)
                {
                    <img src="@url" alt="@post.Attachment.OriginalName" />
                }
                else if (kind == ContentKind.Video)
                {
                    <video controls src="@url"></video>
                }
                else if (kind == ContentKind.Audio)
                {
                    <audio controls src="@url"></audio>
                }
                else
                {
                    <p>📎 <a href="@url" target="_blank" download="@post.Attachment.OriginalName">@post.Attachment.OriginalName</a></p>
                }
            }

            <div>
                <button class="link" @onclick="() => Like(post)">👍 @post.Likes</button>
            </div>

            @foreach (var c in post.Comments)
            {
                <div class="comment"><b>@c.Author</b>: @c.Text</div>
            }

            @if (Session.IsSignedIn)
            {
                <div style="display:flex; gap:6px; margin-top:8px">
                    <input type="text" placeholder="Write a comment..." @bind="newComments[post.Id]" @bind:event="oninput" style="margin:0" />
                    <button @onclick="() => AddComment(post)">Send</button>
                </div>
            }
        </div>
    }

    @if (feed.Count == 0)
    {
        <div class="card">Nothing here yet. Be the first to share something!</div>
    }
</div>

@code {
    string loginName = "";

    string newTitle = "";
    string newBody = "";
    string newSubject = "";
    IBrowserFile? selectedFile;
    int inputKey = 0;
    string message = "";

    string search = "";
    string filterSubject = "";

    IReadOnlyList<Post> feed = Array.Empty<Post>();
    Dictionary<int, string> newComments = new();

    protected override async Task OnInitializedAsync()
    {
        newSubject = Subjects.All[0];
        await LoadFeed();
    }

    void Login()
    {
        if (string.IsNullOrWhiteSpace(loginName)) return;
        Session.SignIn(loginName);
        loginName = "";
    }

    void Logout() => Session.SignOut();

    void OnFileChosen(InputFileChangeEventArgs e) => selectedFile = e.File;

    async Task LoadFeed()
    {
        feed = await Repository.FindAsync(new PostQuery(filterSubject, search));

        foreach (var post in feed)
        {
            if (!newComments.ContainsKey(post.Id))
                newComments[post.Id] = "";
        }
    }

    async Task Publish()
    {
        message = "";
        if (string.IsNullOrWhiteSpace(newTitle))
        {
            message = "Please enter a title.";
            return;
        }
        if (string.IsNullOrWhiteSpace(newBody) && selectedFile is null)
        {
            message = "Write something or attach a file.";
            return;
        }

        StoredFile? attachment = null;
        if (selectedFile is not null)
        {
            try
            {
                await using var stream = selectedFile.OpenReadStream(Storage.MaxFileSizeBytes);
                attachment = await Storage.SaveAsync(selectedFile.Name, stream);
            }
            catch (IOException)
            {
                message = "That file is too large.";
                return;
            }
        }

        await Repository.AddAsync(new NewPost(
            Session.UserName!, newTitle.Trim(), newBody.Trim(), newSubject, attachment));

        newTitle = "";
        newBody = "";
        selectedFile = null;
        inputKey++;      // resets the file picker
        await LoadFeed();
    }

    async Task Like(Post post)
    {
        await Repository.AddLikeAsync(post.Id);
        await LoadFeed();
    }

    async Task AddComment(Post post)
    {
        var text = newComments[post.Id];
        if (string.IsNullOrWhiteSpace(text)) return;

        await Repository.AddCommentAsync(new NewComment(post.Id, Session.UserName!, text.Trim()));
        newComments[post.Id] = "";
        await LoadFeed();
    }

    async Task DeletePost(Post post)
    {
        await Repository.DeleteAsync(post.Id);
        if (post.Attachment is not null)
            await Storage.DeleteAsync(post.Attachment.StoredName);
        await LoadFeed();
    }
}
